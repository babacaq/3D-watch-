<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="PrismLab"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasCode="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="prismlab" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- «Открыть с помощью» для моделей -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="model/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.glb" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.gltf" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.obj" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.stl" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.glb" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.gltf" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.obj" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.stl" />
            </intent-filter>
        </activity>
    </application>
</manifest>
